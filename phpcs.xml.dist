<?xml version="1.0"?>
<ruleset name="WHMCS ConnectReseller">
    <description>PSR-12 for the ConnectReseller WHMCS fork</description>
    <rule ref="PSR12"/>
    <file>modules</file>
    <file>crons</file>
    <file>tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/templates/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
